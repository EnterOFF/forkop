#!/bin/sh /etc/rc.common
# shellcheck disable=SC2034

# The state service answers what Forkop is doing, so it runs whether or not
# Forkop itself does - a stopped service is exactly when the page most needs a
# fast, truthful answer. It starts early and independently of the main service
# for that reason.
START=98
USE_PROCD=1

FORKOP_LIB="/usr/lib/forkop"
FORKOP_STATE_SERVICE_UC="$FORKOP_LIB/service/state_service.uc"
FORKOP_LUCI_VIEW="/www/luci-static/resources/view/forkop/main.js"

# FORKOP_LIB is deliberately not exported, for the same reason the main init
# script does not export it: service/state_service.uc resolves the precompiled
# library cache itself, and pinning the source directory here would make this
# long-lived process parse every module from source.
resolved_library() {
    ucode -L "$FORKOP_LIB" -e '
        let bytecode = null;
        try {
            bytecode = loadfile("'"$FORKOP_LIB"'/core/bytecode.uc")();
        }
        catch (e) {
        }
        print(bytecode == null ? "'"$FORKOP_LIB"'" : bytecode.refresh(), "\n");
    ' 2>/dev/null || printf '%s\n' "$FORKOP_LIB"
}

# The service exists to answer the LuCI page. Where that page is not installed
# there is nobody to answer, so no instance is registered at all - procd then has
# nothing to supervise, which is quieter than starting a process that exits.
# Installing the LuCI app later starts it: its uci-defaults calls
# `forkop luci_postinst`, which brings the service up.
luci_app_installed() {
    [ -r "$FORKOP_LUCI_VIEW" ]
}

start_service() {
    [ -r "$FORKOP_STATE_SERVICE_UC" ] || return 1
    luci_app_installed || return 0

    local library
    library="$(resolved_library)"
    [ -n "$library" ] || library="$FORKOP_LIB"

    procd_open_instance
    procd_set_param command ucode -L "$library" "$library/service/state_service.uc" run
    procd_set_param env FORKOP_LIB="$library"
    procd_set_param respawn 3600 5 0
    procd_set_param stderr 1
    procd_close_instance
}
