#!/usr/bin/ucode

let fs = require("fs");

function as_string(value) {
    return value == null ? "" : "" + value;
}

const SOURCE_LIB_DIR = getenv("FORKOP_SOURCE_LIB") || "/usr/lib/forkop";

// Modules are parsed from source on every process start, which on a router
// costs more than most commands do. core/bytecode.uc keeps a compiled copy of
// the library in tmpfs and hands back the directory to load from; the fallback
// is the source tree, so a cache that cannot be built or trusted only costs
// what it always cost. An explicit FORKOP_LIB still wins, both for tests and
// because every child process already receives the resolved directory that way.
function resolved_library_dir() {
    try {
        return loadfile(SOURCE_LIB_DIR + "/core/bytecode.uc")().refresh();
    }
    catch (e) {
        return SOURCE_LIB_DIR;
    }
}

const LIB_DIR = getenv("FORKOP_LIB") || resolved_library_dir();
const BIN_PATH = getenv("FORKOP_BIN") || "/usr/bin/forkop";
const SERVICE_INIT = getenv("FORKOP_SERVICE_INIT") || "/etc/init.d/forkop";

function shell_quote(value) {
    return "'" + replace(as_string(value), /'/g, "'\\''") + "'";
}

function command_from_args(args) {
    let parts = [];
    for (let arg in args)
        push(parts, shell_quote(arg));
    return join(" ", parts);
}

// Every module below spawns further modules from FORKOP_LIB, so the resolved
// directory is exported once here instead of being resolved again at each level.
function module_command(args) {
    return "FORKOP_LIB=" + shell_quote(LIB_DIR) + " " + command_from_args(args);
}

function module_path(path) {
    return LIB_DIR + "/" + as_string(path);
}

function file_readable(path) {
    return fs.stat(as_string(path)) != null;
}

function show_help() {
    print("Usage: ", BIN_PATH, " COMMAND\n\n");
    print("Available commands:\n");
    print("    start                   Start Forkop service\n");
    print("    stop                    Stop Forkop service\n");
    print("    reload                  Reload Forkop configuration\n");
    print("    restart                 Restart Forkop service\n");
    print("    enable                  Enable Forkop autostart\n");
    print("    disable                 Disable Forkop autostart\n");
    print("    uninstall               Remove Forkop files installed outside opkg/apk\n");
    print("    main                    Run main Forkop process\n");
    print("    check_proxy             Check proxy connectivity\n");
    print("    check_nft_rules         Check NFT rules status\n");
    print("    check_sing_box          Check sing-box installation and status\n");
    print("    check_inbounds_config   Check whether enabled server inbounds are configured\n");
    print("    check_inbounds          Check server inbounds from the Servers tab\n");
    print("    check_logs              Show Forkop logs from system journal\n");
    print("    check_sing_box_logs     Show sing-box logs\n");
    print("    check_fakeip            Test sing-box FakeIP DNS\n");
    print("    clash_http              Allowlisted Clash API transport fallback\n");
    print("    show_config             Display current Forkop configuration\n");
    print("    show_version            Show Forkop version\n");
    print("    show_sing_box_config    Show sing-box configuration\n");
    print("    get_status              Get Forkop service status\n");
    print("    get_sing_box_status     Get sing-box service status\n");
    print("    get_system_info         Get system information in JSON format\n");
    print("    get_ui_capabilities     Get lightweight UI capabilities in JSON format\n");
    print("    get_subscription_default_headers\n");
    print("                            Get default subscription request headers in JSON format\n");
    print("    get_ui_state            Get lightweight UI service/action state in JSON format\n");
    print("    get_section_rule_sets   Map each section to its rule-set tags in JSON format\n");
    print("    service_action_async    Start a service action in the background\n");
    print("    service_action_status   Get background service action status\n");
    print("    ui_action_ack           Acknowledge a finished UI action state\n");
    print("    generate_reality_keypair\n");
    print("                            Generate a sing-box Reality key pair in JSON format\n");
    print("    generate_server_certificate <subject> <name>\n");
    print("                            Generate a self-signed TLS key pair in JSON format\n");
    print("    generate_ssh_host_key <name>\n");
    print("                            Generate a persistent SSH host key in JSON format\n");
    print("    generate_warp_profile   Generate a Cloudflare WARP profile in JSON format\n");
    print("    get_tls_certificate_sha256 [server]\n");
    print("                            Get a server TLS certificate SHA-256 fingerprint in JSON format\n");
    print("    component_action        Manage the Forkop and sing-box components\n");
    print("    component_action_async  Start a component action in the background\n");
    print("    component_action_status Get background component action status\n");
    print("    component_updates_if_due Check installed components for updates when due\n");
    print("    component_update_check_cache Get cached component update check results\n");
    print("    check_dns_available     Check DNS server availability\n");
    print("    global_check            Run global system check\n");
}

// Starting, stopping and reloading belong to the init script. Its start is what
// registers the service with procd, and that registration carries the triggers
// the Apply button and a WAN coming up rely on: a runtime started around the
// init script runs without them, and the page says it is running while Apply
// does nothing.
function init_command_arguments(command) {
    let commands = {
        start: 0,
        stop: 0,
        restart: 0,
        reload: 1
    };

    return commands[as_string(command)];
}

function command_spec(command) {
    let commands = {
        enable: [ "service/lifecycle.uc", "enable", 0 ],
        disable: [ "service/lifecycle.uc", "disable", 0 ],
        uninstall: [ "service/lifecycle.uc", "uninstall", 0 ],
        main: [ "service/lifecycle.uc", "main", 0 ],
        sing_box_crash_cleanup: [ "service/lifecycle.uc", "sing-box-crash-cleanup", 1 ],
        check_proxy: [ "diagnostics/runtime.uc", "check-proxy", 0 ],
        check_nft_rules: [ "diagnostics/runtime.uc", "check-nft-rules", 0 ],
        check_sing_box: [ "diagnostics/runtime.uc", "check-sing-box", 0 ],
        check_inbounds_config: [ "diagnostics/runtime.uc", "check-inbounds-config", 0 ],
        check_inbounds: [ "diagnostics/runtime.uc", "check-inbounds", 0 ],
        check_logs: [ "diagnostics/logs.uc", "forkop", 0 ],
        check_sing_box_logs: [ "diagnostics/logs.uc", "sing-box", 0 ],
        check_fakeip: [ "diagnostics/runtime.uc", "check-fakeip", 0 ],
        clash_http: [ "singbox/clash_http.uc", "request", 3 ],
        clash_summary: [ "singbox/clash_http.uc", "summary", 0 ],
        show_config: [ "diagnostics/runtime.uc", "show-config", 1 ],
        show_version: [ "diagnostics/runtime.uc", "show-version", 0 ],
        show_sing_box_config: [ "diagnostics/runtime.uc", "show-sing-box-config", 1 ],
        get_status: [ "diagnostics/runtime.uc", "get-status", 0 ],
        get_sing_box_status: [ "diagnostics/runtime.uc", "get-sing-box-status", 0 ],
        get_system_info: [ "diagnostics/runtime.uc", "get-system-info", 0 ],
        get_ui_capabilities: [ "service/ui.uc", "get-ui-capabilities", 0 ],
        get_subscription_default_headers: [ "service/ui.uc", "get-subscription-default-headers", 0 ],
        get_ui_state: [ "service/ui.uc", "get-ui-state", 0 ],
        get_section_rule_sets: [ "singbox/section_rulesets.uc", "get-section-rule-sets", 0 ],
        service_action_async: [ "service/ui.uc", "service-action-async", 1 ],
        service_action_status: [ "service/ui.uc", "service-action-status", 1 ],
        ui_action_ack: [ "service/ui.uc", "action-ack", 2 ],
        generate_reality_keypair: [ "server/service.uc", "generate-reality-keypair", 0 ],
        generate_server_certificate: [ "server/service.uc", "generate-server-certificate", 2 ],
        generate_ssh_host_key: [ "server/service.uc", "generate-ssh-host-key", 1 ],
        generate_warp_profile: [ "singbox/runtime.uc", "generate-warp-profile", 0 ],
        get_tls_certificate_sha256: [ "server/service.uc", "tls-certificate-sha256", 1 ],
        component_action: [ "components/action.uc", "component-action", 2 ],
        component_action_async: [ "components/updates.uc", "component-action-async", 2 ],
        component_action_status: [ "components/updates.uc", "component-action-status", 1 ],
        component_updates_if_due: [ "components/updates.uc", "component-updates-if-due", 0 ],
        component_update_check_cache: [ "components/updates.uc", "component-update-check-cache", 0 ],
        check_dns_available: [ "diagnostics/runtime.uc", "check-dns-available", 0 ],
        global_check: [ "diagnostics/runtime.uc", "global-check", 2 ],
        package_prerm: [ "service/package.uc", "prerm", 1 ],
        package_postinst: [ "service/package.uc", "postinst", 0 ],
        luci_postinst: [ "service/package.uc", "luci-postinst", 0 ],
        luci_prerm: [ "service/package.uc", "luci-prerm", 0 ]
    };

    return commands[as_string(command)];
}

function run_spec(command, spec, user_args) {
    let module = module_path(spec[0]);
    if (!file_readable(module)) {
        warn("Error: required file '", module, "' is missing or not readable\n");
        return 1;
    }

    let args = [ "ucode", "-L", LIB_DIR, module, spec[1] ];
    let count = int(spec[2] || 0);
    for (let i = 0; i < count; i++)
        push(args, user_args[i] || "");

    return system(module_command(args));
}

function run_init_command(command, count, user_args) {
    if (!file_readable(SERVICE_INIT)) {
        warn("Error: init script '", SERVICE_INIT, "' is missing or not readable\n");
        return 1;
    }

    let args = [ SERVICE_INIT, command ];
    for (let i = 0; i < count; i++)
        push(args, user_args[i] || "");

    return system(command_from_args(args));
}

function main() {
    let command = ARGV[0] || "";
    let user_args = [];
    for (let i = 1; i < length(ARGV); i++)
        push(user_args, ARGV[i]);

    let init_count = init_command_arguments(command);
    if (init_count != null)
        return run_init_command(command, init_count, user_args);

    let spec = command_spec(command);
    if (spec == null) {
        show_help();
        return 1;
    }

    return run_spec(command, spec, user_args);
}

exit(main());
