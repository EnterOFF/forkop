msgid "Use an https:// URL to proxy a site or file:// to serve a directory"
msgstr "Укажите https://-адрес для проксирования сайта или file:// для отдачи каталога"

msgid "Use an IP address with a CIDR prefix"
msgstr "Укажите IP-адрес с префиксом CIDR"

msgid "Use an IP address, 0.0.0.0 for all IPv4, or :: for all addresses"
msgstr "Укажите IP-адрес, 0.0.0.0 для всех IPv4 или :: для всех адресов"

msgid "Use an OpenSSH public key line"
msgstr "Укажите строку публичного ключа OpenSSH"

msgid "Use another section as an intermediate hop to connect to servers in this section. Does not apply to network interfaces, Tailscale, JSON outbounds, or JSON endpoints"
msgstr "Использовать другую секцию как промежуточный узел для подключения к серверам этой секции. Не применяется к сетевым интерфейсам, Tailscale, JSON outbound и JSON endpoint"

msgid "Use letters, digits, dots, underscores, or hyphens"
msgstr "Используйте буквы, цифры, точки, подчёркивания или дефисы"

msgid "Use lowercase letters, digits and hyphens"
msgstr "Используйте строчные буквы, цифры и дефисы"

msgid "Use sing-box duration format like 1d, 12h or 30m"
msgstr "Используйте формат длительности sing-box, например 1d, 12h или 30m"

msgid "Use subnets other devices share"
msgstr "Использовать подсети, анонсированные другими устройствами"

msgid "Use the pattern => replacement form"
msgstr "Используйте форму шаблон => замена"

msgid "Used by"
msgstr "Используется"

msgid "User name"
msgstr "Имя пользователя"

msgid "UUID"
msgstr "UUID"

msgid "Valid"
msgstr "Валидно"

msgid "Validation errors:"
msgstr "Ошибки валидации:"

msgid "Value cannot be empty"
msgstr "Значение не может быть пустым"

msgid "Value must not contain control characters"
msgstr "Значение не должно содержать управляющие символы"

msgid "Version is compatible (newer than 1.12.4)"
msgstr "Версия совместима (новее 1.12.4)"

msgid "WAN"
msgstr "WAN"

msgid "WAN public IP"
msgstr "Публичный WAN IP"

msgid "WARP profile"
msgstr "Профиль WARP"

msgid "What to do when this section's conditions match"
msgstr "Что делать при совпадении условий этой секции"

msgid "Where to send the traffic from this server"
msgstr "Куда направлять трафик этого сервера"

msgid "Which servers end up in the group"
msgstr "Какие серверы попадут в группу"

msgid "Which servers to import"
msgstr "Какие серверы импортировать"

msgid "Who resolves domains no rule matched. The router resolver keeps local names, ad blocking and the provider DNS; Forkop DNS resolves everything itself and leaves only local names on the router"
msgstr "Кто резолвит домены, не попавшие ни под одно правило. Резолвер роутера сохраняет локальные имена, блокировку рекламы и DNS провайдера; DNS Forkop резолвит всё сам и оставляет роутеру только локальные имена"

msgid "WireGuard address and private key are required"
msgstr "Адрес WireGuard и приватный ключ обязательны"

msgid "WireGuard addresses and AllowedIPs must use valid CIDR subnets"
msgstr "Адреса WireGuard и AllowedIPs должны быть корректными подсетями CIDR"

msgid "WireGuard configuration must contain Interface and Peer sections"
msgstr "Конфигурация WireGuard должна содержать секции Interface и Peer"

msgid "WireGuard keys must be standard base64-encoded 32-byte values"
msgstr "Ключи WireGuard должны быть значениями стандартного base64 длиной 32 байта"

msgid "WireGuard peer"
msgstr "Пир WireGuard"

msgid "WireGuard peer allowed_ips must contain valid CIDR subnets"
msgstr "Поле allowed_ips пира WireGuard должно содержать корректные подсети CIDR"

msgid "WireGuard peer contains unsupported fields"
msgstr "Пир WireGuard содержит неподдерживаемые поля"

msgid "WireGuard peer fields must use native sing-box JSON types"
msgstr "Поля пира WireGuard должны использовать нативные типы JSON sing-box"

msgid "WireGuard peer settings"
msgstr "Настройки пира WireGuard"

msgid "WireGuard, AmneziaWG, Cloudflare WARP, Tailscale and JSON endpoint are available"
msgstr "Доступны WireGuard, AmneziaWG, Cloudflare WARP, Tailscale и JSON endpoint"

msgid "Write ${1} instead of $1 when a letter follows the group number"
msgstr "Используйте ${1} вместо $1, если после номера группы идёт буква"

msgid "XHTTP mode"
msgstr "Режим XHTTP"

msgid "YACD Secret Key"
msgstr "Секретный ключ YACD"

msgid "Yes"
msgstr "Да"

msgid "Zapret hostlist templates are not supported here because Forkop does not expand them for per-rule NFQWS strategies."
msgstr "Шаблоны hostlist zapret здесь не поддерживаются, потому что Forkop не разворачивает их для per-rule стратегий NFQWS."

msgid "Zapret2 hostlist templates are not supported here because Forkop does not expand them for per-rule NFQWS2 strategies."
msgstr "Шаблоны hostlist Zapret2 здесь не поддерживаются, потому что Forkop не разворачивает их для per-rule стратегий NFQWS2."
