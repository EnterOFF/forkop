{
  "luci-app-forkop": {
    "description": "Grant UCI and RPC access to LuCI app Forkop",
    "read": {
      "file": {
        "/usr/bin/forkop": [
          "exec"
        ]
      },
      "ubus": {
        "forkop": [
          "state",
          "state_wait",
          "system_info",
          "logs",
          "log_text",
          "usage",
          "refresh"
        ],
        "forkop.installer": [
          "read",
          "input",
          "stop"
        ],
        "luci-rpc": [
          "getDHCPLeases",
          "getHostHints"
        ],
        "network.interface": [
          "dump"
        ]
      },
      "uci": [
        "dhcp",
        "forkop"
      ]
    },
    "write": {
      "uci": [
        "forkop"
      ]
    }
  }
}
