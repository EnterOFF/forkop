msgid "WireGuard configuration must contain Interface and Peer sections"
msgstr "Конфигурация WireGuard должна содержать секции Interface и Peer"

msgid "WireGuard keys must be standard base64-encoded 32-byte values"
msgstr "Ключи WireGuard должны быть значениями стандартного base64 длиной 32 байта"

msgid "WireGuard peer"
msgstr "Пир WireGuard"

msgid "WireGuard peer allowed_ips must contain valid CIDR subnets"
msgstr "Поле allowed_ips пира WireGuard должно содержать корректные подсети CIDR"

msgid "WireGuard peer contains unsupported fields"
msgstr "Пир WireGuard содержит неподдерживаемые поля"

msgid "WireGuard peer fields must use native sing-box JSON types"
msgstr "Поля пира WireGuard должны использовать нативные типы JSON sing-box"

msgid "WireGuard peer hostname or IP address."
msgstr "Имя хоста или IP-адрес пира WireGuard."

msgid "WireGuard peer settings"
msgstr "Настройки пира WireGuard"

msgid "WireGuard, AmneziaWG 2.0, Cloudflare WARP, and Tailscale tunnels"
msgstr "Туннели WireGuard, AmneziaWG 2.0, Cloudflare WARP и Tailscale"

msgid "XHTTP mode"
msgstr "Режим XHTTP"

msgid "YACD Secret Key"
msgstr "Секретный ключ YACD"

msgid "Yes"
msgstr "Да"

msgid "You can select Output Network Interface, by default autodetect"
msgstr "Вы можете выбрать выходной сетевой интерфейс, по умолчанию он определяется автоматически."

msgid "Zapret hostlist templates are not supported here because Forkop does not expand them for per-rule NFQWS strategies."
msgstr "Шаблоны hostlist zapret здесь не поддерживаются, потому что Forkop не разворачивает их для per-rule стратегий NFQWS."

